---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={Astro.resolve("/favicon.svg")} />
    <link rel="icon" href={Astro.resolve("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <title>Tess Urwin</title>
  </head>

  <body class="min-h-screen bg-white text-zinc-900">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a class="font-semibold" href={Astro.resolve("/")}>Tess Urwin</a>
      <div class="flex gap-4 text-sm text-zinc-700">
        <a class="hover:underline" href={Astro.resolve("/about")}>About</a>
        <a class="hover:underline" href={Astro.resolve("/projects")}>Projects</a>
        <a class="hover:underline" href={Astro.resolve("/resume")}>Resume</a>
        <a class="hover:underline" href={Astro.resolve("/updates")}>Updates</a>
        <a class="hover:underline" href={Astro.resolve("/contact")}>Contact</a>
      </div>
    </nav>

    <main class="mx-auto max-w-3xl px-6">
      <slot />
    </main>
  </body>
</html>

