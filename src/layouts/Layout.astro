---
import "../styles/global.css";

const BASE_URL = import.meta.env.BASE_URL; // e.g. "/tess-portfolio/"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${BASE_URL}favicon.ico`} />

    <meta name="generator" content={Astro.generator} />
    <title>Tess Urwin</title>
  </head>

  <body class="min-h-screen bg-white text-zinc-900">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a class="font-semibold" href={BASE_URL}>Tess Urwin</a>

      <div class="flex gap-4 text-sm text-zinc-700">
        <a class="hover:underline" href={`${BASE_URL}about/`}>About</a>
        <a class="hover:underline" href={`${BASE_URL}projects/`}>Projects</a>
        <a class="hover:underline" href={`${BASE_URL}resume/`}>Resume</a>
        <a class="hover:underline" href={`${BASE_URL}updates/`}>Updates</a>
        <a class="hover:underline" href={`${BASE_URL}contact/`}>Contact</a>
      </div>
    </nav>

    <main class="mx-auto max-w-3xl px-6">
      <slot />
    </main>
  </body>
</html>

