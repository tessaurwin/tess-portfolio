---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Updates</h1>
    <p class="mt-2 text-zinc-600 max-w-2xl">
      Short notes on what I’m building and learning.
    </p>

    <div class="mt-8 space-y-6">
      <div class="rounded-2xl border border-zinc-200 p-5">
        <div class="text-xs text-zinc-500">Jan 2026</div>
        <div class="mt-1 font-semibold">Portfolio v1 launched</div>
        <p class="mt-2 text-sm text-zinc-600">
          Astro + Tailwind on GitHub Pages, content collections for projects, resume embed working.
        </p>
      </div>

      <div class="rounded-2xl border border-zinc-200 p-5">
        <div class="text-xs text-zinc-500">Jan 2026</div>
        <div class="mt-1 font-semibold">Added new project writeups</div>
        <p class="mt-2 text-sm text-zinc-600">
          Documented FireBot sensor R&amp;D and started writing up FPGA work.
        </p>
      </div>
    </div>
  </section>
</Layout>

