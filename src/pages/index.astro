---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const BASE_URL = import.meta.env.BASE_URL;

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Tessa Urwin">
  <!-- HERO -->
  <section class="pt-14 pb-10">
    <div class="grid gap-8 md:grid-cols-2 md:items-start">
      <!-- Left: intro -->
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50 px-3 py-1 text-xs text-rose-600">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-500"></span>
          MS ECE @ UIC • Digital Systems / VLSI
        </div>

        <h1 class="mt-4 text-5xl font-semibold tracking-tight">
          Tessa Urwin
        </h1>

        <p class="mt-4 max-w-xl text-lg text-zinc-600">
          ** Website under construction as of 1/31/26! **
          Electrical &amp; Computer Engineer focused on embedded systems, digital design, VLSI, and computer architecture.
          I like building reliable hardware-software systems and documenting what I learn.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={`${BASE_URL}projects/`}>View Projects</a>
          <a class="btn btn-secondary" href={`${BASE_URL}resume/`}>Resume</a>
          <a class="btn btn-secondary" href={`${BASE_URL}contact/`}>Contact</a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="pill">Embedded</span>
          <span class="pill">FPGA / Verilog</span>
          <span class="pill">PCB / Sensors</span>
          <span class="pill">Validation</span>
        </div>
      </div>

      <!-- Right: cards -->
      <div class="grid gap-4">
        <div class="card">
          <div class="section-title">Currently</div>
          <p class="mt-3 text-sm text-zinc-600">
            Building a stronger embedded + HDL portfolio while diving deeper into digital design and VLSI workflows.
          </p>
        </div>

        <div class="card">
          <div class="section-title">Highlights</div>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-zinc-600">
            <li>FireBot sensor R&amp;D (robotics + embedded)</li>
            <li>FPGA / Verilog projects + tooling</li>
            <li>Electronics prototyping &amp; validation</li>
          </ul>
        </div>

        <div class="card">
          <div class="section-title">Quick links</div>
          <div class="mt-3 flex flex-wrap gap-3 text-sm">
            <a class="link" href={`${BASE_URL}projects/firebot/`}>FireBot →</a>
            <a class="link" href={`${BASE_URL}projects/capstone-temp-sensor/`}>Capstone →</a>
            <a class="link" href={`${BASE_URL}projects/transistor-level-sram/`}>SRAM →</a>
          </div>
          <p class="mt-3 text-xs text-zinc-500">
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="mt-16">
    <div class="flex items-center justify-between gap-4">
      <h2 class="section-title">Featured projects</h2>
      <a class="link" href={`${BASE_URL}projects/`}>View all →</a>
    </div>

    <div class="mt-4 grid gap-4">
      {projects.map((p) => (
        <a class="card block" href={`${BASE_URL}projects/${p.slug}/`}>
          <div class="flex gap-4">
            {p.data.heroImage && (
              <img
                src={`${BASE_URL}${p.data.heroImage}`}
                alt={`${p.data.title} thumbnail`}
                class="h-16 w-16 rounded-xl border border-rose-100 object-cover"
                loading="lazy"
              />
            )}

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div class="truncate font-semibold">{p.data.title}</div>
                <div class="shrink-0 text-xs text-zinc-500">{p.data.date.toDateString()}</div>
              </div>

              {p.data.summary && (
                <p class="mt-2 text-sm text-zinc-600">{p.data.summary}</p>
              )}

              {p.data.tags?.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {p.data.tags.slice(0, 5).map((t) => (
                    <span class="pill">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- SKILLS -->
  <section class="mt-16 pb-6">
    <h2 class="section-title">Skills</h2>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card">
        <div class="font-semibold">Embedded / Firmware</div>
        <p class="mt-2 text-sm text-zinc-600">C/C++, microcontrollers, peripherals, debugging.</p>
      </div>

      <div class="card">
        <div class="font-semibold">Digital Design</div>
        <p class="mt-2 text-sm text-zinc-600">Verilog/SystemVerilog, simulation, synthesis flow.</p>
      </div>

      <div class="card">
        <div class="font-semibold">PCB / Hardware</div>
        <p class="mt-2 text-sm text-zinc-600">KiCad, schematics, layout, bring-up.</p>
      </div>

      <div class="card">
        <div class="font-semibold">Validation</div>
        <p class="mt-2 text-sm text-zinc-600">Bench testing, instrumentation, data + iteration.</p>
      </div>
    </div>
  </section>
</Layout>

