---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout>
  <article class="py-12">
    <a class="text-sm text-zinc-600 underline-offset-4 hover:underline" href="/projects">
      ← Back to Projects
    </a>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{project.data.title}</h1>
    <p class="mt-2 text-sm text-zinc-500">{project.data.date.toDateString()}</p>

    <div class="mt-4 flex gap-3">
      {project.data.repo && (
        <a class="rounded-xl border border-zinc-200 px-3 py-1 text-sm hover:border-zinc-300" href={project.data.repo}>
          Repo
        </a>
      )}
      {project.data.demo && (
        <a class="rounded-xl border border-zinc-200 px-3 py-1 text-sm hover:border-zinc-300" href={project.data.demo}>
          Demo
        </a>
      )}
    </div>

    <div class="prose prose-zinc mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Layout>

