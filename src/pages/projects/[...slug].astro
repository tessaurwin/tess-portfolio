---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const BASE_URL = import.meta.env.BASE_URL;

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={`${project.data.title} • Tess Urwin`}>
  <article class="py-12">
    <a
      class="text-sm text-zinc-600 underline-offset-4 hover:underline"
      href={`${BASE_URL}projects/`}
    >
      ← Back to Projects
    </a>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{project.data.title}</h1>
    <p class="mt-2 text-sm text-zinc-500">{project.data.date.toDateString()}</p>

    {/* Hero image */}
    {project.data.heroImage && (
      <div class="mt-8 overflow-hidden rounded-2xl border border-zinc-200">
        <img
          src={`${BASE_URL}${project.data.heroImage}`}
          alt={`${project.data.title} hero image`}
          class="w-full object-cover max-h-[420px]"
          loading="eager"
        />
      </div>
    )}

    {/* Buttons: repo/demo/docs */}
    <div class="mt-6 flex flex-wrap gap-3">
      {project.data.repo && (
        <a
          class="rounded-xl border border-zinc-200 px-3 py-1 text-sm hover:border-zinc-300"
          href={project.data.repo}
          target="_blank"
          rel="noreferrer"
        >
          Repo
        </a>
      )}

      {project.data.demo && (
        <a
          class="rounded-xl border border-zinc-200 px-3 py-1 text-sm hover:border-zinc-300"
          href={project.data.demo}
          target="_blank"
          rel="noreferrer"
        >
          Demo
        </a>
      )}

      {project.data.docs?.map((d) => (
        <a
          class="rounded-xl border border-zinc-200 px-3 py-1 text-sm hover:border-zinc-300"
          href={`${BASE_URL}${d.href}`}
          target="_blank"
          rel="noreferrer"
        >
          {d.label}
        </a>
      ))}
    </div>

    {/* Main markdown content */}
    <div class="markdown mt-8 max-w-none">
      <Content />
    </div>

    {/* Gallery */}
    {project.data.gallery?.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-semibold">Gallery</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {project.data.gallery.map((img) => (
            <a
              href={`${BASE_URL}${img.src}`}
              target="_blank"
              rel="noreferrer"
              class="block overflow-hidden rounded-2xl border border-zinc-200 hover:border-zinc-300"
            >
              <img
                src={`${BASE_URL}${img.src}`}
                alt={img.alt ?? ""}
                class="h-64 w-full object-cover"
                loading="lazy"
              />
            </a>
          ))}
        </div>

        <p class="mt-3 text-sm text-zinc-500">
          Click an image to open full size.
        </p>
      </section>
    )}
  </article>
</Layout>

