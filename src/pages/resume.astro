---
import Layout from "../layouts/Layout.astro";

const resumeUrl = new URL("resume.pdf", Astro.url).toString();
---

<Layout>
  <section class="py-12">
    ...
    <a href={resumeUrl} target="_blank">Open PDF</a>
    <a href={resumeUrl} download>Download</a>

    <iframe src={resumeUrl} class="h-[900px] w-full"></iframe>
  </section>
</Layout>

